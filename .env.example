# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase dashboard → Project Settings → API Keys → Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=

# Used server-side only for admin sign-in (Project Settings → API Keys → Publishable key)
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated emails allowed to sign in to /admin (then run: npm run admins)
ADMIN_EMAILS=

# Starting password for admin accounts created by `npm run admins` (keep out of git)
ADMIN_DEFAULT_PASSWORD=

# Payload CMS (/cms). Supabase dashboard → Connect → Session pooler connection string
DATABASE_URL=
# Long random string used to sign CMS sessions, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Base URL used when generating guest links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
